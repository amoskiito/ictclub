# Copy this file to ".env" (same folder) and fill in your own values.
# The real .env file is ignored by git, so your secrets never reach GitHub.

# --- Database ---
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017
# Or MongoDB Atlas:
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/
# Keep "class_demo" to keep the users and registrations you already have.
MONGO_DB=class_demo

# --- Server ---
PORT=3000
# Address of the React app (used for CORS and links inside emails)
CLIENT_URL=http://localhost:5173

# --- Security ---
# REQUIRED in production. Use a long random string, e.g. run:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# The person with this email becomes an admin when they sign up (or at server start if they already exist).
ADMIN_EMAIL=

# Optional: only allow these email domains to sign up (comma separated), e.g. students.myuni.ac.ke
ALLOWED_EMAIL_DOMAINS=

# --- Email (optional) ---
# Without SMTP settings, emails (verification, password reset, RSVP, reminders) are printed in the server terminal instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ICT Club <no-reply@example.com>"
# Where contact form messages are emailed (optional, they are always saved in the admin dashboard)
CONTACT_EMAIL=
